{
  "name": "aza-ductulator",
  "version": "1.0.0",
  "description": "AZA Technologies Air Duct Calculator - cross-platform ductulator app for Android and macOS.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "mac:dev": "npm run build && electron .",
    "mac:dist": "npm run build && electron-builder --mac --config electron-builder.yml"
  },
  "keywords": ["ductulator", "hvac", "duct", "calculator", "aza"],
  "author": "AZA Technologies",
  "license": "UNLICENSED",
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  }
}
